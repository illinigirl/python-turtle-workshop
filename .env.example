# Copy this file to .env and fill in values. All of it is optional —
# the workshop runs fine without any of it (the AI helper just stays off).

# Enable the optional AI "Ask the helper" feature:
ANTHROPIC_API_KEY=

# AI helper model. Default is Haiku (fast + cheap, great for kids' questions).
# Use claude-opus-4-8 for maximum quality.
TUTOR_MODEL=claude-haiku-4-5

# Customize the "Who's coding?" profile buttons (comma-separated):
# WORKSHOP_PROFILES=Ada,Grace,Alan

# Server host/port (defaults shown):
# WORKSHOP_HOST=0.0.0.0
# WORKSHOP_PORT=8095
